
@{
    ViewBag.Title = "Accountant Advice Preparation";
    ViewBag.Title_mini = "Accountant Advice Preparation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script>
    
</script>
<div class="box">
    <div class="box-head">
        <header>
            <h4 class="text-bold">Transaction List</h4>
        </header>
        <div class="tools">
            <div class="btn-group ">
                <a id="export" href="#" class="btn btn-equal btn-sm btn-excel" style="width:100px"><i class="fa fa-file"></i> Export to excel</a>
                <a class="btn btn-equal btn-sm btn-refresh"><i class="fa fa-refresh"></i></a>
                <a class="btn btn-equal btn-sm btn-collapse"><i class="fa fa-angle-down"></i></a>
                <a class="btn btn-equal btn-sm btn-close"><i class="fa fa-times"></i></a>
            </div>
        </div>
        <hr />
    </div>
    <div class="box-body">

        <div class="box">
            <div class="box-body" style="padding-top:10px">
                <div class="row">
                    <div class="col-md-8">
                   
                        Date of Advice
                        @(Html.Kendo().DatePicker()
                        .Name("dtp_to")
                        .Format("MMMM dd, yyyy")
                        .Value(DateTime.Now)
                        .HtmlAttributes(new { type = "text" })
                        .Events(ev => ev.Change("param_dateadvice"))
                        )
                    </div>
                    <div class="col-md-4">
                        <div class="input-group" style="padding-bottom:5px!important">
                            <input id="txt_search_dvno" type="text" class="form-control navbar-input" placeholder="Search Advice No.">
                            <span class="input-group-btn">
                                <button class="btn btn-equal" type="button"><i class="fa fa-search"></i></button>
                            </span>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-8">
                        Advice No.
                        @(Html.Kendo().DropDownList()
                    .Name("drpadviceacc")
                    .DataTextField("AdviceNo")
                    .DataValueField("AdviceNo")
                    .SelectedIndex(-1)
                    .Filter("Contains")
                    .AutoBind(false)
                    .DataSource(source =>
                    {
                        source.Read(read =>
                        {
                            read.Action("DataSource_GetAdviceNo", "JEV").Data("para_advice"); ;
                        });
                    })
                    //.Events(e => e.Change("r_liaison"))
                    //.HtmlAttributes(new { style = "width: 100%" })
                        )
                    </div>
                </div>
                <script>
                 $('#txt_search_dvno').on('keyup', function (e) {
                var SelectedTabIndex = $("#tabstrip").data("kendoTabStrip").select().index();
                if (SelectedTabIndex == 0) {
                    var gridData = $("#grid_transactions").data("kendoGrid");
                    if ($('#txt_search_dvno').val() == "") {
                        gridData.dataSource.filter({});
                    }
                    else {
                        ISfn.applyFilter("AdviceNo", $('#txt_search_dvno').val(), 'grid_transactions'),
                        //ISfn.applyFilter("Particular", $('#txt_search_dvno').val(), 'grid_transactions')
                        gridData.dataSource.sort({ field: "Name", dir: "asc" });
                    }
                }
                else {
                    var gridDatav2 = $("#grid_transactions_acic").data("kendoGrid");
                    if ($('#txt_search_dvno').val() == "") {
                        gridDatav2.dataSource.filter({});
                    }
                    else {
                        ISfn.applyFilter("Name", $('#txt_search_dvno').val(), 'grid_transactions_acic')
                        gridDatav2.dataSource.sort({ field: "Name", dir: "asc" });
                    }
                }
            })
            function para_advice() {
                var to = kendo.toString($("#dtp_to").data('kendoDatePicker').value(), "MM/dd/yyyy");
                return { to: to }
            }

            function para_liaison (){
                return { officeid: $("#officeId").data("kendoDropDownList").value() }
            }
            function param_dateadvice(){
                //$("#drpadviceacc").data("kendoDropDownList").value("");
                var r_l = $("#drpadviceacc").data("kendoDropDownList")
                r_l.dataSource.read();
            }
            function param_dateadvice() {
                var gridData = $("#grid_transactions").data("kendoGrid");
                var drpData=$("#drpadviceacc").data("kendoDropDownList");
                gridData.dataSource.read();
                drpData.dataSource.read();
            }
            function para_transaction() {
                var to = $('#dtp_to').data('kendoDatePicker').value();
                return {to: to }
            }
            function fn_refresher(e) {
                var SelectedTabIndex = $("#tabstrip").data("kendoTabStrip").select().index();

                if (SelectedTabIndex == 0) {
                    $("#grid_transactions").data("kendoGrid").dataSource.read();
                }
                else if (SelectedTabIndex == 1) {
                    $("#grid_transactions_acic").data("kendoGrid").dataSource.read();
                }

            }

            $("#export").click(function (e) {
                var grid = $("#grid_transactions").data("kendoGrid");
                grid.saveAsExcel();
            });
                </script>
                <div class="row" style="margin-top:10px">
                    @(Html.Kendo().TabStrip()
                      .Name("tabstrip")
                      .Navigatable(false)
                      .Animation(animation =>
                          animation.Open(effect =>
                          effect.Fade(FadeDirection.In)))
                      .Items(tabstrip =>
                      {
                          tabstrip.Add().Text("Prepared").Selected(true).LoadContentFrom("_JEV_Entries_T1", "Jev");
                          tabstrip.Add().Text("Generated").LoadContentFrom("_JEV_Entries_T2", "Jev");
                      })
                      .Events(e => e.Activate("fn_refresher"))
                    )
                </div>
            </div>
        </div>
        <div class="modal-footer" id="generateacicfile_id" style="margin-top:-20px;">
            <button class="btn btn-success" onclick="downloadATMFile()">   <i class="fa fa-file"></i> Generate ACIC File</button>
        </div>
    </div>
</div>

<script>
   
    function downloadATMFile() {
        var from = $('#dtp_from').data('kendoDatePicker').value();
        var to = $('#dtp_to').data('kendoDatePicker').value();

        if (from) from = kendo.toString(from, "yyyy-MM-dd");
        if (to) to = kendo.toString(to, "yyyy-MM-dd");

        var idsToSend = [];
        var grid = $("#grid_transactions").data("kendoGrid")
        var ds = grid.dataSource.view();
        for (var i = 0; i < ds.length; i++) {
            var row = grid.table.find("tr[data-uid='" + ds[i].uid + "']");
            var checkbox = $(row).find(".checkbox");
            if (checkbox.is(":checked")) {
                idsToSend.push(ds[i].jevid); //loops
            }
        }
        if (idsToSend == "" ) {
            toastr.warning('Please tick the checkbox first!', 'System Warning')
        }
        else {
            @*$.post('@Url.Action("Save_transaction_through_checkno", "JEV")', { checkno: checkno, jevid: $("#txt_jevid").val() }*@
            $.post('@Url.Action("Save_GenerateACICFile", "JEV")', { trnno: idsToSend, from: from, to: to }
            , function (r) {
                stopSpin()
                //if (r.code == 6) {
                //    toastr.success(r.statusName, 'System Message');
                //    //$("#txt_jevid").val(r.newjevID)
                //    param_dateadvice();
                //}
                //else {
                //    mg.warning("" + r.statusName + "")
                //}
            })
        }
    }
    function CheckAll_Prep(e) {
        $("#grid_transactions tbody input:checkbox").prop("checked", e.checked);
    }
</script>
